/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. kona QRD";
	compatible = "qcom,kona-qrd", "qcom,kona", "qcom,qrd";
	qcom,board-id = <0x0b 0x00>;

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150@0 {
				compatible = "qcom,spmi-pmic";
				reg = <0x00 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
					interrupts = <0x00 0x08 0x00 0x03 0x00 0x08 0x01 0x03>;
					interrupt-names = "kpdpwr", "resin";
					qcom,pon-dbc-delay = <0x3d09>;
					qcom,kpdpwr-sw-debounce;
					qcom,system-reset;
					qcom,store-hard-reset-reason;

					qcom,pon_1 {
						qcom,pon-type = <0x00>;
						linux,code = <0x74>;
						qcom,pull-up;
					};

					qcom,pon_2 {
						qcom,pon-type = <0x01>;
						linux,code = <0x72>;
						qcom,pull-up;
					};
				};

				qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x00 0x24 0x00 0x03>;
					io-channels = <0x01 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x02>;
				};

				clock-controller@5b00 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x5b00 0x200>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x02>;
					clock-output-names = "pm8150_div_clk1", "pm8150_div_clk2";
					clocks = <0xffffffff 0x00>;
					clock-names = "xo";
					phandle = <0x92>;
				};

				sdam@b100 {
					compatible = "qcom,spmi-sdam";
					reg = <0xb100 0x100>;
					phandle = <0x0c>;
				};

				pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xa00>;
					interrupts = <0x00 0xc0 0x00 0x00 0x00 0xc2 0x00 0x00 0x00 0xc5 0x00 0x00 0x00 0xc6 0x00 0x00 0x00 0xc8 0x00 0x00 0x00 0xc9 0x00 0x00>;
					interrupt-names = "pm8150_gpio1", "pm8150_gpio3", "pm8150_gpio6", "pm8150_gpio7", "pm8150_gpio9", "pm8150_gpio10";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x02 0x04 0x05 0x08>;
					phandle = <0x08>;

					key_home {

						key_home_default {
							pins = "gpio1";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0x74>;
						};
					};

					imu_clkin {

						imu_clkin_default {
							pins = "gpio3";
							function = "func1";
							output-low;
							power-source = <0x00>;
							bias-disable;
							qcom,dtest-buffer = <0x01>;
							qcom,drive-strength = <0x01>;
							phandle = <0x93>;
						};

						imu_clkin_sleep {
							pins = "gpio3";
							function = "func1";
							input-enable;
							bias-pull-down;
							power-source = <0x00>;
							qcom,dtest-buffer = <0x01>;
							qcom,drive-strength = <0x01>;
							phandle = <0x94>;
						};
					};

					key_vol_up {

						key_vol_up_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x01>;
							phandle = <0x73>;
						};
					};

					key_confirm {

						key_confirm_default {
							pins = "gpio7";
							function = "normal";
							input-enable;
							bias-pull-up;
							power-source = <0x00>;
							phandle = <0x95>;
						};
					};

					usb2_vbus_boost {

						usb2_vbus_boost_default {
							pins = "gpio9";
							function = "normal";
							output-low;
							power-source = <0x01>;
							phandle = <0x96>;
						};
					};

					usb2_vbus_det {

						usb2_vbus_det_default {
							pins = "gpio10";
							function = "normal";
							input-enable;
							bias-pull-down;
							power-source = <0x01>;
							phandle = <0x97>;
						};
					};
				};

				qcom,pm8150_rtc {
					compatible = "qcom,pm8941-rtc";
					interrupts = <0x00 0x61 0x01 0x00>;
					phandle = <0x98>;
				};

				vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x01>;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					vcoin@85 {
						reg = <0x85>;
						label = "vcoin";
						qcom,pre-scaling = <0x01 0x03>;
					};

					xo_therm@4c {
						reg = <0x4c>;
						label = "xo_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					skin_therm@4d {
						reg = <0x4d>;
						label = "skin_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					pa_therm1@4e {
						reg = <0x4e>;
						label = "pa_therm1";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};
				};

				adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x00 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					io-channels = <0x01 0x4c 0x01 0x4d 0x01 0x4e>;
					phandle = <0x7a>;

					xo_therm@4c {
						reg = <0x4c>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					skin_therm@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};

					pa_therm1@4e {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150@1 {
				compatible = "qcom,spmi-pmic";
				reg = <0x01 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			pm8150_tz {
				polling-delay-passive = <0x64>;
				polling-delay = <0x00>;
				thermal-governor = "step_wise";
				thermal-sensors = <0x02>;
				wake-capable-sensor;
				phandle = <0x99>;

				trips {

					trip0 {
						temperature = <0x17318>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x9a>;
					};

					trip1 {
						temperature = <0x1c138>;
						hysteresis = <0x00>;
						type = "passive";
						phandle = <0x9b>;
					};

					trip2 {
						temperature = <0x23668>;
						hysteresis = <0x00>;
						type = "passive";
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			interrupt-controller;
			#interrupt-cells = <0x04>;

			qcom,pm8150b@2 {
				compatible = "qcom,spmi-pmic";
				reg = <0x02 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,revid@100 {
					compatible = "qcom,qpnp-revid";
					reg = <0x100 0x100>;
					phandle = <0x06>;
				};

				qcom,power-on@800 {
					compatible = "qcom,qpnp-power-on";
					reg = <0x800 0x100>;
				};

				qcom,temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400 0x100>;
					interrupts = <0x02 0x24 0x00 0x03>;
					io-channels = <0x03 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					qcom,temperature-threshold-set = <0x01>;
					phandle = <0x0f>;
				};

				clock-controller@6000 {
					compatible = "qcom,spmi-clkdiv";
					reg = <0x6000 0x100>;
					#clock-cells = <0x01>;
					qcom,num-clkdivs = <0x01>;
					clock-output-names = "pm8150b_div_clk1";
					clocks = <0xffffffff 0x00>;
					clock-names = "xo";
					phandle = <0x9c>;
				};

				qcom,pbs@7200 {
					compatible = "qcom,qpnp-pbs";
					reg = <0x7200 0x100>;
					phandle = <0x0b>;
				};

				qcom,sdam-qnovo@b000 {
					compatible = "qcom,qpnp-qnovo5";
					reg = <0xb000 0x100>;
					interrupts = <0x02 0xb0 0x01 0x01>;
					interrupt-names = "ptrain-done";
					pinctrl-names = "q_state1", "q_state2";
					pinctrl-0 = <0x04>;
					pinctrl-1 = <0x05>;
					phandle = <0x9d>;
				};

				pinctrl@c000 {
					compatible = "qcom,spmi-gpio";
					reg = <0xc000 0xc00>;
					interrupts = <0x02 0xc0 0x00 0x00 0x02 0xc1 0x00 0x00 0x02 0xc4 0x00 0x00 0x02 0xc5 0x00 0x00 0x02 0xc6 0x00 0x00 0x02 0xc7 0x00 0x00 0x02 0xc8 0x00 0x00 0x02 0xc9 0x00 0x00 0x02 0xcb 0x00 0x00>;
					interrupt-names = "pm8150b_gpio1", "pm8150b_gpio2", "pm8150b_gpio5", "pm8150b_gpio6", "pm8150b_gpio7", "pm8150b_gpio8", "pm8150b_gpio9", "pm8150b_gpio10", "pm8150b_gpio12";
					gpio-controller;
					#gpio-cells = <0x02>;
					qcom,gpios-disallowed = <0x03 0x04 0x0b>;
					phandle = <0x18>;

					qnovo_fet_ctrl {

						qnovo_fet_ctrl_state1 {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-disable;
							power-source = <0x00>;
							phandle = <0x04>;
						};

						qnovo_fet_ctrl_state2 {
							pins = "gpio8";
							function = "normal";
							input-enable;
							output-disable;
							bias-pull-down;
							power-source = <0x00>;
							phandle = <0x05>;
						};
					};

					smb_stat {

						smb_stat_default {
							pins = "gpio6";
							function = "normal";
							input-enable;
							bias-pull-up;
							qcom,pull-up-strength = <0x00>;
							power-source = <0x00>;
							phandle = <0x75>;
						};
					};

					haptics_boost {

						haptics_boost_default {
							pins = "gpio5";
							function = "normal";
							output-enable;
							input-disable;
							bias-disable;
							qcom,drive-strength = <0x03>;
							power-source = <0x01>;
							phandle = <0x19>;
						};
					};
				};

				qcom,qpnp-smb5 {
					compatible = "qcom,qpnp-smb5";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					#cooling-cells = <0x02>;
					device_type = "battery";
					qcom,pmic-revid = <0x06>;
					qcom,thermal-mitigation = <0x3d0900 0x3b8260 0x39fbc0 0x36ee80 0x30d400 0x2ab980 0x249f00 0x1e8480 0x1b7740 0x186a00 0x155cc0 0x124f80 0xf4240 0xc3500 0x927c0 0x7a120>;
					qcom,chg-term-src = <0x01>;
					qcom,charger-temp-max = <0x320>;
					qcom,smb-temp-max = <0x320>;
					status = "ok";
					dpdm-supply = <0xffffffff>;
					qcom,sec-charger-config = <0x01>;
					qcom,auto-recharge-vbat-mv = <0x111c>;
					io-channels = <0x03 0x1e 0x03 0x07 0x03 0x4f 0x03 0x99 0x03 0x83 0x03 0x09>;
					io-channel-names = "mid_voltage", "usb_in_current", "conn_temp", "sbux_res", "vph_voltage", "chg_temp";
					qcom,battery-data = <0x07>;
					qcom,wd-bark-time-secs = <0x10>;
					qcom,smb-internal-pull-kohm = <0x00>;
					qcom,pd-thermal-mitigation = <0x5b8d80 0x532910 0x50df20 0x4c4b40 0x4630c0 0x401640 0x39fbc0 0x33e140 0x30d400 0x2dc6c0 0x2ab980 0x27ac40 0x249f00 0x249f00 0x2191c0 0x200b20>;
					qcom,chg-control-gpio = <0x08 0x0a 0x00>;
					lenovo,jeita_enable = <0x01>;
					qcom,fv-max-uv = <0x448310>;
					qcom,fcc-max-ua = <0x5b8d80>;
					qcom,max-voltage-uv = <0x448310>;
					qcom,fastchg-current-ma = <0x1770>;
					qcom,jeita-fcc-ranges = <0x00 0x96 0x2dc6c0 0x96 0x1c2 0x2dc6c0 0x1c2 0x1f4 0x2dc6c0>;
					qcom,jeita-fv-ranges = <0x00 0x1f4 0x43e6d0>;
					qcom,otg-cl-ua = <0x1b7740>;
					qcom,hvdcp2-max-icl-ua = <0x1e8480>;
					phandle = <0x7d>;

					qcom,chgr@1000 {
						reg = <0x1000 0x100>;
						interrupts = <0x02 0x10 0x00 0x01 0x02 0x10 0x01 0x01 0x02 0x10 0x02 0x01 0x02 0x10 0x03 0x01 0x02 0x10 0x04 0x01 0x02 0x10 0x06 0x03 0x02 0x10 0x07 0x03>;
						interrupt-names = "chgr-error", "chg-state-change", "step-chg-state-change", "step-chg-soc-update-fail", "step-chg-soc-update-req", "vph-alarm", "vph-drop-prechg";
					};

					qcom,dcdc@1100 {
						reg = <0x1100 0x100>;
						interrupts = <0x02 0x11 0x00 0x03 0x02 0x11 0x01 0x03 0x02 0x11 0x02 0x03 0x02 0x11 0x04 0x03 0x02 0x11 0x05 0x03 0x02 0x11 0x06 0x03 0x02 0x11 0x07 0x03>;
						interrupt-names = "otg-fail", "otg-oc-disable-sw", "otg-oc-hiccup", "high-duty-cycle", "input-current-limiting", "concurrent-mode-disable", "switcher-power-ok";
					};

					qcom,batif@1200 {
						reg = <0x1200 0x100>;
						interrupts = <0x02 0x12 0x00 0x01 0x02 0x12 0x02 0x03 0x02 0x12 0x03 0x03 0x02 0x12 0x04 0x03 0x02 0x12 0x05 0x03 0x02 0x12 0x06 0x03 0x02 0x12 0x07 0x03>;
						interrupt-names = "bat-temp", "bat-ov", "bat-low", "bat-therm-or-id-missing", "bat-terminal-missing", "buck-oc", "vph-ov";
					};

					qcom,usb@1300 {
						reg = <0x1300 0x100>;
						interrupts = <0x02 0x13 0x00 0x03 0x02 0x13 0x01 0x03 0x02 0x13 0x02 0x03 0x02 0x13 0x03 0x03 0x02 0x13 0x04 0x03 0x02 0x13 0x05 0x03 0x02 0x13 0x06 0x01 0x02 0x13 0x07 0x01>;
						interrupt-names = "usbin-collapse", "usbin-vashdn", "usbin-uv", "usbin-ov", "usbin-plugin", "usbin-revi-change", "usbin-src-change", "usbin-icl-change";
					};

					qcom,dc@1400 {
						reg = <0x1400 0x100>;
						interrupts = <0x02 0x14 0x01 0x03 0x02 0x14 0x02 0x03 0x02 0x14 0x03 0x03 0x02 0x14 0x04 0x03 0x02 0x14 0x05 0x03 0x02 0x14 0x06 0x03 0x02 0x14 0x07 0x03>;
						interrupt-names = "dcin-vashdn", "dcin-uv", "dcin-ov", "dcin-plugin", "dcin-revi", "dcin-pon", "dcin-en";
					};

					qcom,typec@1500 {
						reg = <0x1500 0x100>;
						interrupts = <0x02 0x15 0x00 0x01 0x02 0x15 0x01 0x03 0x02 0x15 0x02 0x01 0x02 0x15 0x03 0x03 0x02 0x15 0x04 0x01 0x02 0x15 0x05 0x01 0x02 0x15 0x06 0x03 0x02 0x15 0x07 0x01>;
						interrupt-names = "typec-or-rid-detect-change", "typec-vpd-detect", "typec-cc-state-change", "typec-vconn-oc", "typec-vbus-change", "typec-attach-detach", "typec-legacy-cable-detect", "typec-try-snk-src-detect";
					};

					qcom,misc@1600 {
						reg = <0x1600 0x100>;
						interrupts = <0x02 0x16 0x00 0x01 0x02 0x16 0x01 0x01 0x02 0x16 0x02 0x03 0x02 0x16 0x03 0x03 0x02 0x16 0x04 0x03 0x02 0x16 0x06 0x03 0x02 0x16 0x07 0x03>;
						interrupt-names = "wdog-snarl", "wdog-bark", "aicl-fail", "aicl-done", "smb-en", "temp-change", "temp-change-smb";
					};

					qcom,smb5-vconn {
						regulator-name = "smb5-vconn";
						phandle = <0x0a>;
					};

					qcom,smb5-vbus {
						regulator-name = "smb5-vbus";
						phandle = <0x09>;
					};
				};

				qcom,usb-pdphy@1700 {
					compatible = "qcom,qpnp-pdphy";
					reg = <0x1700 0x100>;
					interrupts = <0x02 0x17 0x00 0x01 0x02 0x17 0x01 0x01 0x02 0x17 0x02 0x01 0x02 0x17 0x03 0x01 0x02 0x17 0x04 0x01 0x02 0x17 0x05 0x01 0x02 0x17 0x06 0x01 0x02 0x17 0x07 0x01>;
					interrupt-names = "sig-tx", "sig-rx", "msg-tx", "msg-rx", "msg-tx-failed", "msg-tx-discarded", "msg-rx-discarded", "fr-swap";
					qcom,default-sink-caps = <0x1388 0xbb8 0x2328 0xbb8 0x2ee0 0x8ca>;
					vdd-pdphy-supply = <0xffffffff>;
					vbus-supply = <0x09>;
					vconn-supply = <0x0a>;
					phandle = <0x1a>;
				};

				bcl@1d00 {
					compatible = "qcom,bcl-v5";
					reg = <0x1d00 0x100>;
					interrupts = <0x02 0x1d 0x00 0x00 0x02 0x1d 0x01 0x00 0x02 0x1d 0x02 0x00>;
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					#thermal-sensor-cells = <0x01>;
					phandle = <0x10>;
				};

				bcl-soc {
					compatible = "qcom,msm-bcl-soc";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x11>;
				};

				qpnp,fg {
					compatible = "qcom,fg-gen4";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					qcom,pmic-revid = <0x06>;
					qcom,pmic-pbs = <0x0b>;
					status = "disabled";
					nvmem-names = "fg_sdam";
					nvmem = <0x0c>;
					qcom,battery-data = <0x07>;
					qcom,hold-soc-while-full;
					qcom,linearize-soc;
					qcom,five-pin-battery;
					qcom,cl-wt-enable;
					qcom,soc-scale-mode-en;
					qcom,fg-esr-timer-chg-fast = <0x00 0x07>;
					qcom,fg-esr-timer-dischg-fast = <0x00 0x07>;
					qcom,fg-esr-timer-chg-slow = <0x00 0x60>;
					qcom,fg-esr-timer-dischg-slow = <0x00 0x60>;
					qcom,fg-esr-cal-soc-thresh = <0x1a 0xe6>;
					qcom,fg-esr-cal-temp-thresh = <0x0a 0x28>;
					phandle = <0x9e>;

					qcom,fg-batt-soc@4000 {
						status = "okay";
						reg = <0x4000 0x100>;
						interrupts = <0x02 0x40 0x00 0x03 0x02 0x40 0x01 0x03 0x02 0x40 0x02 0x01 0x02 0x40 0x03 0x01 0x02 0x40 0x04 0x03 0x02 0x40 0x05 0x01 0x02 0x40 0x06 0x03 0x02 0x40 0x07 0x03>;
						interrupt-names = "soc-update", "soc-ready", "bsoc-delta", "msoc-delta", "msoc-low", "msoc-empty", "msoc-high", "msoc-full";
					};

					qcom,fg-batt-info@4100 {
						status = "okay";
						reg = <0x4100 0x100>;
						interrupts = <0x02 0x41 0x00 0x03 0x02 0x41 0x01 0x03 0x02 0x41 0x03 0x01>;
						interrupt-names = "vbatt-low", "vbatt-pred-delta", "esr-delta";
					};

					qcom,fg-rradc@4200 {
						status = "okay";
						reg = <0x4200 0x100>;
						interrupts = <0x02 0x42 0x00 0x03 0x02 0x42 0x01 0x03 0x02 0x42 0x02 0x03 0x02 0x42 0x03 0x03 0x02 0x42 0x04 0x03>;
						interrupt-names = "batt-missing", "batt-id", "batt-temp-delta", "batt-temp-hot", "batt-temp-cold";
					};

					qcom,fg-memif@4300 {
						status = "okay";
						reg = <0x4300 0x100>;
						interrupts = <0x02 0x43 0x00 0x03 0x02 0x43 0x01 0x03 0x02 0x43 0x02 0x03 0x02 0x43 0x03 0x01 0x02 0x43 0x04 0x02>;
						interrupt-names = "ima-rdy", "ima-xcp", "dma-xcp", "dma-grant", "mem-attn";
					};
				};

				vadc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100 0x100 0x3700 0x100>;
					reg-names = "adc5-usr-base", "adc5-cal-base";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x02 0x31 0x00 0x01>;
					interrupt-names = "eoc-int-en-set";
					qcom,adc-vdd-reference = <0x753>;
					#io-channel-cells = <0x01>;
					io-channel-ranges;
					phandle = <0x03>;

					ref_gnd@0 {
						reg = <0x00>;
						label = "ref_gnd";
						qcom,pre-scaling = <0x01 0x01>;
					};

					vref_1p25@1 {
						reg = <0x01>;
						label = "vref_1p25";
						qcom,pre-scaling = <0x01 0x01>;
					};

					die_temp@2 {
						reg = <0x06>;
						label = "die_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					chg_temp@9 {
						reg = <0x09>;
						label = "chg_temp";
						qcom,pre-scaling = <0x01 0x01>;
					};

					bat_id@4b {
						reg = <0x4b>;
						label = "bat_id";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					smb1390_therm@e {
						reg = <0x0e>;
						label = "smb1390_therm";
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					smb1355_therm@4e {
						reg = <0x4e>;
						label = "smb1355_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					vph_pwr@83 {
						reg = <0x83>;
						label = "vph_pwr";
						qcom,pre-scaling = <0x01 0x03>;
					};

					conn_therm@4f {
						reg = <0x4f>;
						label = "conn_therm";
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
					};

					chg_sbux@99 {
						reg = <0x99>;
						label = "chg_sbux";
						qcom,pre-scaling = <0x01 0x03>;
					};

					mid_chg_div6@1e {
						reg = <0x1e>;
						label = "chg_mid";
						qcom,pre-scaling = <0x01 0x06>;
					};

					usb_in_i_uv@7 {
						reg = <0x07>;
						label = "usb_in_i_uv";
						qcom,pre-scaling = <0x01 0x01>;
					};

					usb_in_v_div_16@8 {
						reg = <0x08>;
						label = "usb_in_v_div_16";
						qcom,pre-scaling = <0x01 0x10>;
					};
				};

				adc_tm@3500 {
					compatible = "qcom,adc-tm5";
					reg = <0x3500 0x100>;
					interrupts = <0x02 0x35 0x00 0x01>;
					interrupt-names = "thr-int-en";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					qcom,pmic-revid = <0x06>;
					io-channels = <0x03 0x4f>;
					phandle = <0x79>;

					conn_therm@4f {
						reg = <0x4f>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
					};
				};
			};

			qcom,pm8150b@3 {
				compatible = "qcom,spmi-pmic";
				reg = <0x03 0x00>;
				#address-cells = <0x02>;
				#size-cells = <0x00>;

				qcom,pwms@b100 {
					compatible = "qcom,pwm-lpg";
					reg = <0xb100 0x200>;
					reg-names = "lpg-base";
					#pwm-cells = <0x02>;
					qcom,num-lpg-channels = <0x02>;
					phandle = <0x0d>;
				};

				qcom,leds@d000 {
					compatible = "qcom,tri-led";
					reg = <0xd000 0x100>;
					nvmem-names = "pbs_sdam";
					nvmem = <0x0c>;
					phandle = <0x9f>;

					hr_led1 {
						label = "hr_led1";
						pwms = <0x0d 0x00 0xf4240>;
						led-sources = <0x00>;
					};

					hr_led2 {
						label = "hr_led2";
						pwms = <0x0d 0x01 0xf4240>;
						led-sources = <0x01>;
					};
				};

				qcom,haptics@c000 {
					compatible = "qcom,haptics";
					reg = <0xc000 0x100>;
					interrupts = <0x03 0xc0 0x00 0x03 0x03 0xc0 0x01 0x03>;
					interrupt-names = "hap-sc-irq", "hap-play-irq";
					qcom,actuator-type = "lra";
					qcom,vmax-mv = <0x6a1>;
					qcom,play-rate-us = <0x16fa>;
					qcom,lra-resonance-sig-shape = "sine";
					qcom,lra-auto-resonance-mode = "qwd";
					qcom,lra-allow-variable-play-rate;
					vdd-supply = <0x0e>;
					phandle = <0xa0>;

					wf_0 {
						qcom,effect-id = <0x00>;
						qcom,wf-vmax-mv = <0x6a1>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x16fa>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_1 {
						qcom,effect-id = <0x01>;
						qcom,wf-vmax-mv = <0x6a1>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x16fa>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_2 {
						qcom,effect-id = <0x02>;
						qcom,wf-vmax-mv = <0x6a1>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x16fa>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_3 {
						qcom,effect-id = <0x03>;
						qcom,wf-vmax-mv = <0x6a1>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x16fa>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_4 {
						qcom,effect-id = <0x04>;
						qcom,wf-vmax-mv = <0x6a1>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x16fa>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};

					wf_5 {
						qcom,effect-id = <0x05>;
						qcom,wf-vmax-mv = <0x6a1>;
						qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
						qcom,wf-play-rate-us = <0x16fa>;
						qcom,wf-brake-pattern = <0x00>;
						qcom,wf-repeat-count = <0x01>;
						qcom,wf-s-repeat-count = <0x01>;
						qcom,lra-auto-resonance-disable;
					};
				};
			};
		};
	};

