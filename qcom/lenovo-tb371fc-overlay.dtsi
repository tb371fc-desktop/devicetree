/dts-v1/;
/plugin/;

#include <dt-bindings/input/qcom,qpnp-power-on.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/iio/qcom,spmi-vadc.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>

/ {
	model = "Qualcomm Technologies, Inc. kona HDK";
	compatible = "qcom,kona-hdk", "qcom,kona", "qcom,hdk";
	qcom,board-id = <0x1001f 0x01>;
};

&spmi_bus {
	#address-cells = <2>;
	#size-cells = <0>;
	interrupt-controller;
	#interrupt-cells = <4>;

	qcom,pm8150@0 {
		compatible = "qcom,spmi-pmic";
		reg = <0x00 0x00>;
		#address-cells = <2>;
		#size-cells = <0>;

		qcom,power-on@800 {
			compatible = "qcom,qpnp-power-on";
			reg = <0x800 0x100>;
			interrupts = <0x00 0x08 0x00 IRQ_TYPE_EDGE_BOTH>,
					 <0x00 0x08 0x01 IRQ_TYPE_EDGE_BOTH>;
			interrupt-names = "kpdpwr", "resin";
			qcom,pon-dbc-delay = <15625>;
			qcom,kpdpwr-sw-debounce;
			qcom,system-reset;
			qcom,store-hard-reset-reason;

			qcom,pon_1 {
				qcom,pon-type = <PON_POWER_ON_TYPE_KPDPWR>;
				linux,code = <KEY_POWER>;
				qcom,pull-up;
			};

			qcom,pon_2 {
				qcom,pon-type = <PON_POWER_ON_TYPE_RESIN>;
				linux,code = <KEY_VOLUMEDOWN>;
				qcom,pull-up;
			};
		};

		pm8150_tz: qcom,temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400 0x100>;
			interrupts = <0x00 0x24 0x00 IRQ_TYPE_EDGE_BOTH>;
			io-channels = <&pm8150_vadc ADC_DIE_TEMP>;
			io-channel-names = "thermal";
			#thermal-sensor-cells = <0>;
			qcom,temperature-threshold-set = <1>;
		};

		pm8150_clkdiv: clock-controller@5b00 {
			compatible = "qcom,spmi-clkdiv";
			reg = <0x5b00 0x200>;
			#clock-cells = <1>;
			qcom,num-clkdivs = <2>;
			clock-output-names = "pm8150_div_clk1", "pm8150_div_clk2";
			clocks = <&clock_rpmh>, <0x00>;
			clock-names = "xo";
		};

		pm8150_sdam_2: sdam@b100 {
			compatible = "qcom,spmi-sdam";
			reg = <0xb100 0x100>;
		};

		pm8150_gpios: pinctrl@c000 {
			compatible = "qcom,spmi-gpio";
			reg = <0xc000 0xa00>;
			interrupts = <0x0 0xc0 0x00 IRQ_TYPE_NONE>,
					 <0x00 0xc2 0x00 IRQ_TYPE_NONE>,
					 <0x00 0xc5 0x00 IRQ_TYPE_NONE>,
					 <0x00 0xc6 0x00 IRQ_TYPE_NONE>,
					 <0x00 0xc8 0x00 IRQ_TYPE_NONE>,
					 <0x00 0xc9 0x00 IRQ_TYPE_NONE>;
			interrupt-names = "pm8150_gpio1", "pm8150_gpio3", "pm8150_gpio6", "pm8150_gpio7", "pm8150_gpio9", "pm8150_gpio10";
			gpio-controller;
			#gpio-cells = <2>;
			qcom,gpios-disallowed = <2 4 5 8>;

			key_home {

				key_home_default: key_home_default {
					pins = "gpio1";
					function = PMIC_GPIO_FUNC_NORMAL;
					input-enable;
					bias-pull-up;
					power-source = <0>;
				};
			};

			imu_clkin {

				imu_clkin_default: imu_clkin_default {
					pins = "gpio3";
					function = PMIC_GPIO_FUNC_FUNC1;
					output-low;
					power-source = <0>;
					bias-disable;
					qcom,dtest-buffer = <1>;
					qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
				};

				imu_clkin_sleep: imu_clkin_sleep {
					pins = "gpio3";
					function = PMIC_GPIO_FUNC_FUNC1;
					input-enable;
					bias-pull-down;
					power-source = <0>;
					qcom,dtest-buffer = <1>;
					qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
				};
			};

			key_vol_up {

				key_vol_up_default: key_vol_up_default {
					pins = "gpio6";
					function = PMIC_GPIO_FUNC_NORMAL;
					input-enable;
					bias-pull-up;
					power-source = <1>;
				};
			};

			key_confirm {

				key_confirm_default: key_confirm_default {
					pins = "gpio7";
					function = PMIC_GPIO_FUNC_NORMAL;
					input-enable;
					bias-pull-up;
					power-source = <0>;
				};
			};

			usb2_vbus_boost {

				usb2_vbus_boost_default: usb2_vbus_boost_default {
					pins = "gpio9";
					function = PMIC_GPIO_FUNC_NORMAL;
					output-low;
					power-source = <1>;
				};
			};

			usb2_vbus_det {

				usb2_vbus_det_default: usb2_vbus_det_default {
					pins = "gpio10";
					function = PMIC_GPIO_FUNC_NORMAL;
					input-enable;
					bias-pull-down;
					power-source = <1>;
				};
			};
		};

		pm8150_rtc: qcom,pm8150_rtc {
			compatible = "qcom,pm8941-rtc";
			interrupts = <0x00 0x61 0x01 IRQ_TYPE_NONE>;
		};

		pm8150_vadc: vadc@3100 {
			compatible = "qcom,spmi-adc5";
			reg = <0x3100 0x100>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <0x0 0x31 0x00 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "eoc-int-en-set";
			qcom,adc-vdd-reference = <1875>;
			#io-channel-cells = <1>;
			io-channel-ranges;

			ref_gnd@0 {
				reg = <ADC_REF_GND>;
				label = "ref_gnd";
				qcom,pre-scaling = <1 1>;
			};

			vref_1p25@1 {
				reg = <ADC_1P25VREF>;
				label = "vref_1p25";
				qcom,pre-scaling = <1 1>;
			};

			die_temp@2 {
				reg = <ADC_DIE_TEMP>;
				label = "die_temp";
				qcom,pre-scaling = <1 1>;
			};

			vph_pwr@83 {
				reg = <ADC_VPH_PWR>;
				label = "vph_pwr";
				qcom,pre-scaling = <1 3>;
			};

			vcoin@85 {
				reg = <ADC_VCOIN>;
				label = "vcoin";
				qcom,pre-scaling = <1 3>;
			};

			xo_therm@4c {
				reg = <ADC_XO_THERM_PU2>;
				label = "xo_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			skin_therm@4d {
				reg = <ADC_AMUX_THM1_PU2>;
				label = "skin_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			pa_therm1@4e {
				reg = <ADC_AMUX_THM2_PU2>;
				label = "pa_therm1";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};
		};

		pm8150_adc_tm: adc_tm@3500 {
			compatible = "qcom,adc-tm5";
			reg = <0x3500 0x100>;
			interrupts = <0x0 0x35 0x00 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "thr-int-en";
			#address-cells = <1>;
			#size-cells = <0>;
			#thermal-sensor-cells = <1>;
			io-channels = <&pm8150_vadc ADC_XO_THERM_PU2>,
					 <&pm8150_vadc ADC_AMUX_THM1_PU2>,
					 <&pm8150_vadc ADC_AMUX_THM2_PU2>;

			xo_therm@4c {
				reg = <ADC_XO_THERM_PU2>;
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
			};

			skin_therm@4d {
				reg = <ADC_AMUX_THM1_PU2>;
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
			};

			pa_therm1@4e {
				reg = <ADC_AMUX_THM2_PU2>;
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
			};
		};
	};

	qcom,pm8150@1 {
		compatible = "qcom,spmi-pmic";
		reg = <0x01 0x00>;
		#address-cells = <2>;
		#size-cells = <0>;
	};
};

&thermal_zones {

	pm8150_temp_alarm: pm8150_tz {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150_tz>;
		wake-capable-sensor;

		trips {

			pm8150_trip0: trip0 {
				temperature = <95000>;
				hysteresis = <0>;
				type = "passive";
			};

			pm8150_trip1: trip1 {
				temperature = <115000>;
				hysteresis = <0>;
				type = "passive";
			};

			trip2 {
				temperature = <145000>;
				hysteresis = <0>;
				type = "passive";
			};
		};
	};
};

&spmi_bus {
	#address-cells = <2>;
	#size-cells = <0>;
	interrupt-controller;
	#interrupt-cells = <4>;

	qcom,pm8150b@2 {
		compatible = "qcom,spmi-pmic";
		reg = <0x02 0x00>;
		#address-cells = <2>;
		#size-cells = <0>;

		pm8150b_revid: qcom,revid@100 {
			compatible = "qcom,qpnp-revid";
			reg = <0x100 0x100>;
		};

		qcom,power-on@800 {
			compatible = "qcom,qpnp-power-on";
			reg = <0x800 0x100>;
		};

		pm8150b_tz: qcom,temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400 0x100>;
			interrupts = <0x02 0x24 0x00 0x03>;
			io-channels = <&pm8150b_vadc ADC_DIE_TEMP>;
			io-channel-names = "thermal";
			#thermal-sensor-cells = <0>;
			qcom,temperature-threshold-set = <1>;
		};

		pm8150b_clkdiv: clock-controller@6000 {
			compatible = "qcom,spmi-clkdiv";
			reg = <0x6000 0x100>;
			#clock-cells = <1>;
			qcom,num-clkdivs = <1>;
			clock-output-names = "pm8150b_div_clk1";
			clocks = <&clock_rpmh RPMH_CXO_CLK>;
			clock-names = "xo";
		};

		pm8150b_pbs1: qcom,pbs@7200 {
			compatible = "qcom,qpnp-pbs";
			reg = <0x7200 0x100>;
		};

		pm8150b_qnovo: qcom,sdam-qnovo@b000 {
			compatible = "qcom,qpnp-qnovo5";
			reg = <0xb000 0x100>;
			interrupts = <0x02 0xb0 0x01 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "ptrain-done";
			pinctrl-names = "q_state1", "q_state2";
			pinctrl-0 = <&qnovo_fet_ctrl_state1>;
			pinctrl-1 = <&qnovo_fet_ctrl_state2>;
		};

		pm8150b_gpios: pinctrl@c000 {
			compatible = "qcom,spmi-gpio";
			reg = <0xc000 0xc00>;
			interrupts = <0x2 0xc0 0x00 IRQ_TYPE_NONE>,
					 <0x02 0xc1 0x00 IRQ_TYPE_NONE>,
					 <0x02 0xc4 0x00 IRQ_TYPE_NONE>,
					 <0x02 0xc5 0x00 IRQ_TYPE_NONE>,
					 <0x02 0xc6 0x00 IRQ_TYPE_NONE>,
					 <0x02 0xc7 0x00 IRQ_TYPE_NONE>,
					 <0x02 0xc8 0x00 IRQ_TYPE_NONE>,
					 <0x02 0xc9 0x00 IRQ_TYPE_NONE>,
					 <0x02 0xcb 0x00 IRQ_TYPE_NONE>;
			interrupt-names = "pm8150b_gpio1", "pm8150b_gpio2", "pm8150b_gpio5", "pm8150b_gpio6", "pm8150b_gpio7", "pm8150b_gpio8", "pm8150b_gpio9", "pm8150b_gpio10", "pm8150b_gpio12";
			gpio-controller;
			#gpio-cells = <2>;
			qcom,gpios-disallowed = <3 4 11>;

			qnovo_fet_ctrl {

				qnovo_fet_ctrl_state1: qnovo_fet_ctrl_state1 {
					pins = "gpio8";
					function = PMIC_GPIO_FUNC_NORMAL;
					input-enable;
					output-disable;
					bias-disable;
					power-source = <0>;
				};

				qnovo_fet_ctrl_state2: qnovo_fet_ctrl_state2 {
					pins = "gpio8";
					function = PMIC_GPIO_FUNC_NORMAL;
					input-enable;
					output-disable;
					bias-pull-down;
					power-source = <0>;
				};
			};

			smb_stat {

				smb_stat_default: smb_stat_default {
					pins = "gpio6";
					function = PMIC_GPIO_FUNC_NORMAL;
					input-enable;
					bias-pull-up;
					qcom,pull-up-strength = <PMIC_GPIO_PULL_UP_30>;
					power-source = <0>;
				};
			};

			haptics_boost {

				haptics_boost_default: haptics_boost_default {
					pins = "gpio5";
					function = PMIC_GPIO_FUNC_NORMAL;
					output-enable;
					input-disable;
					bias-disable;
					qcom,drive-strength = <PMIC_GPIO_STRENGTH_HIGH>;
					power-source = <1>;
				};
			};
		};

		pm8150b_charger: qcom,qpnp-smb5 {
			compatible = "qcom,qpnp-smb5";
			#address-cells = <1>;
			#size-cells = <1>;
			#cooling-cells = <2>;
			device_type = "battery";
			qcom,pmic-revid = <&pm8150b_revid>;
			qcom,thermal-mitigation = <4000000 3900000 3800000 3600000 0x30d400 0x2ab980 0x249f00 0x1e8480 0x1b7740 0x186a00 0x155cc0 0x124f80 0xf4240 0xc3500 0x927c0 0x7a120>;
			qcom,chg-term-src = <1>;
			qcom,charger-temp-max = <800>;
			qcom,smb-temp-max = <800>;
			status = "ok";
			dpdm-supply = <&usb2_phy0>;
			qcom,sec-charger-config = <1>;
			qcom,auto-recharge-vbat-mv = <4380>;
			io-channels = <&pm8150b_vadc 0x1e>, <&pm8150b_vadc 0x7>, <&pm8150b_vadc 0x4f>, <&pm8150b_vadc 0x99>, <&pm8150b_vadc 0x83>, <&pm8150b_vadc 0x9>;
			io-channel-names = "mid_voltage", "usb_in_current", "conn_temp", "sbux_res", "vph_voltage", "chg_temp";
			qcom,battery-data = <&kona_qrd_batterydata>;
			qcom,wd-bark-time-secs = <16>;
			qcom,smb-internal-pull-kohm = <0>;
			qcom,pd-thermal-mitigation = <6000000 5450000 5300000 5000000 4600000 4200000 3800000 3400000 3200000 3000000 2800000 2600000 2400000 2400000 2200000 2100000>;
			qcom,chg-control-gpio = <&pm8150_gpios 0xa 0x0>;
			lenovo,jeita_enable = <1>;
			qcom,fv-max-uv = <4490000>;
			qcom,fcc-max-ua = <6000000>;
			qcom,max-voltage-uv = <4490000>;
			qcom,fastchg-current-ma = <6000>;
			qcom,jeita-fcc-ranges = <0 150 3000000 150 450 3000000 450 500 3000000>;
			qcom,jeita-fv-ranges = <0 500 4450000>;
			qcom,otg-cl-ua = <1800000>;
			qcom,hvdcp2-max-icl-ua = <2000000>;

			qcom,chgr@1000 {
				reg = <0x1000 0x100>;
				interrupts = <0x02 0x10 0x00 0x01 0x02 0x10 0x01 0x01 0x02 0x10 0x02 0x01 0x02 0x10 0x03 0x01 0x02 0x10 0x04 0x01 0x02 0x10 0x06 0x03 0x02 0x10 0x07 0x03>;
				interrupt-names = "chgr-error", "chg-state-change", "step-chg-state-change", "step-chg-soc-update-fail", "step-chg-soc-update-req", "vph-alarm", "vph-drop-prechg";
			};

			qcom,dcdc@1100 {
				reg = <0x1100 0x100>;
				interrupts = <0x02 0x11 0x00 0x03 0x02 0x11 0x01 0x03 0x02 0x11 0x02 0x03 0x02 0x11 0x04 0x03 0x02 0x11 0x05 0x03 0x02 0x11 0x06 0x03 0x02 0x11 0x07 0x03>;
				interrupt-names = "otg-fail", "otg-oc-disable-sw", "otg-oc-hiccup", "high-duty-cycle", "input-current-limiting", "concurrent-mode-disable", "switcher-power-ok";
			};

			qcom,batif@1200 {
				reg = <0x1200 0x100>;
				interrupts = <0x02 0x12 0x00 0x01 0x02 0x12 0x02 0x03 0x02 0x12 0x03 0x03 0x02 0x12 0x04 0x03 0x02 0x12 0x05 0x03 0x02 0x12 0x06 0x03 0x02 0x12 0x07 0x03>;
				interrupt-names = "bat-temp", "bat-ov", "bat-low", "bat-therm-or-id-missing", "bat-terminal-missing", "buck-oc", "vph-ov";
			};

			qcom,usb@1300 {
				reg = <0x1300 0x100>;
				interrupts = <0x02 0x13 0x00 0x03 0x02 0x13 0x01 0x03 0x02 0x13 0x02 0x03 0x02 0x13 0x03 0x03 0x02 0x13 0x04 0x03 0x02 0x13 0x05 0x03 0x02 0x13 0x06 0x01 0x02 0x13 0x07 0x01>;
				interrupt-names = "usbin-collapse", "usbin-vashdn", "usbin-uv", "usbin-ov", "usbin-plugin", "usbin-revi-change", "usbin-src-change", "usbin-icl-change";
			};

			qcom,dc@1400 {
				reg = <0x1400 0x100>;
				interrupts = <0x02 0x14 0x01 0x03 0x02 0x14 0x02 0x03 0x02 0x14 0x03 0x03 0x02 0x14 0x04 0x03 0x02 0x14 0x05 0x03 0x02 0x14 0x06 0x03 0x02 0x14 0x07 0x03>;
				interrupt-names = "dcin-vashdn", "dcin-uv", "dcin-ov", "dcin-plugin", "dcin-revi", "dcin-pon", "dcin-en";
			};

			qcom,typec@1500 {
				reg = <0x1500 0x100>;
				interrupts = <0x02 0x15 0x00 0x01 0x02 0x15 0x01 0x03 0x02 0x15 0x02 0x01 0x02 0x15 0x03 0x03 0x02 0x15 0x04 0x01 0x02 0x15 0x05 0x01 0x02 0x15 0x06 0x03 0x02 0x15 0x07 0x01>;
				interrupt-names = "typec-or-rid-detect-change", "typec-vpd-detect", "typec-cc-state-change", "typec-vconn-oc", "typec-vbus-change", "typec-attach-detach", "typec-legacy-cable-detect", "typec-try-snk-src-detect";
			};

			qcom,misc@1600 {
				reg = <0x1600 0x100>;
				interrupts = <0x02 0x16 0x00 0x01 0x02 0x16 0x01 0x01 0x02 0x16 0x02 0x03 0x02 0x16 0x03 0x03 0x02 0x16 0x04 0x03 0x02 0x16 0x06 0x03 0x02 0x16 0x07 0x03>;
				interrupt-names = "wdog-snarl", "wdog-bark", "aicl-fail", "aicl-done", "smb-en", "temp-change", "temp-change-smb";
			};

			smb5_vconn: qcom,smb5-vconn {
				regulator-name = "smb5-vconn";
			};

			smb5_vbus: qcom,smb5-vbus {
				regulator-name = "smb5-vbus";
			};
		};

		pm8150b_pdphy: qcom,usb-pdphy@1700 {
			compatible = "qcom,qpnp-pdphy";
			reg = <0x1700 0x100>;
			interrupts = <0x02 0x17 0x00 0x01 0x02 0x17 0x01 0x01 0x02 0x17 0x02 0x01 0x02 0x17 0x03 0x01 0x02 0x17 0x04 0x01 0x02 0x17 0x05 0x01 0x02 0x17 0x06 0x01 0x02 0x17 0x07 0x01>;
			interrupt-names = "sig-tx", "sig-rx", "msg-tx", "msg-rx", "msg-tx-failed", "msg-tx-discarded", "msg-rx-discarded", "fr-swap";
			qcom,default-sink-caps = <5000 3000 9000 3000 12000 2250>;
			vdd-pdphy-supply = <&pm8150_l2>;
			vbus-supply = <&smb5_vbus>;
			vconn-supply = <&smb5_vconn>;
		};

		pm8150b_bcl: bcl@1d00 {
			compatible = "qcom,bcl-v5";
			reg = <0x1d00 0x100>;
			interrupts = <0x2 0x1d 0x00 0x00 0x02 0x1d 0x01 0x00 0x02 0x1d 0x02 0x00>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			#thermal-sensor-cells = <1>;
		};

		bcl_soc: bcl-soc {
			compatible = "qcom,msm-bcl-soc";
			#thermal-sensor-cells = <0>;
		};

		pm8150b_fg: qpnp,fg {
			compatible = "qcom,fg-gen4";
			#address-cells = <1>;
			#size-cells = <1>;
			qcom,pmic-revid = <&pm8150b_revid>;
			qcom,pmic-pbs = <&pm8150b_pbs1>;
			status = "disabled";
			nvmem-names = "fg_sdam";
			nvmem = <&pm8150_sdam_2>;
			qcom,battery-data = <0x07>;
			qcom,hold-soc-while-full;
			qcom,linearize-soc;
			qcom,five-pin-battery;
			qcom,cl-wt-enable;
			qcom,soc-scale-mode-en;
			qcom,fg-esr-timer-chg-fast = <0x00 0x07>;
			qcom,fg-esr-timer-dischg-fast = <0x00 0x07>;
			qcom,fg-esr-timer-chg-slow = <0x00 0x60>;
			qcom,fg-esr-timer-dischg-slow = <0x00 0x60>;
			qcom,fg-esr-cal-soc-thresh = <0x1a 0xe6>;
			qcom,fg-esr-cal-temp-thresh = <0x0a 0x28>;

			qcom,fg-batt-soc@4000 {
				status = "okay";
				reg = <0x4000 0x100>;
				interrupts = <0x02 0x40 0x00 0x03 0x02 0x40 0x01 0x03 0x02 0x40 0x02 0x01 0x02 0x40 0x03 0x01 0x02 0x40 0x04 0x03 0x02 0x40 0x05 0x01 0x02 0x40 0x06 0x03 0x02 0x40 0x07 0x03>;
				interrupt-names = "soc-update", "soc-ready", "bsoc-delta", "msoc-delta", "msoc-low", "msoc-empty", "msoc-high", "msoc-full";
			};

			qcom,fg-batt-info@4100 {
				status = "okay";
				reg = <0x4100 0x100>;
				interrupts = <0x02 0x41 0x00 0x03 0x02 0x41 0x01 0x03 0x02 0x41 0x03 0x01>;
				interrupt-names = "vbatt-low", "vbatt-pred-delta", "esr-delta";
			};

			qcom,fg-rradc@4200 {
				status = "okay";
				reg = <0x4200 0x100>;
				interrupts = <0x02 0x42 0x00 0x03 0x02 0x42 0x01 0x03 0x02 0x42 0x02 0x03 0x02 0x42 0x03 0x03 0x02 0x42 0x04 0x03>;
				interrupt-names = "batt-missing", "batt-id", "batt-temp-delta", "batt-temp-hot", "batt-temp-cold";
			};

			qcom,fg-memif@4300 {
				status = "okay";
				reg = <0x4300 0x100>;
				interrupts = <0x02 0x43 0x00 0x03 0x02 0x43 0x01 0x03 0x02 0x43 0x02 0x03 0x02 0x43 0x03 0x01 0x02 0x43 0x04 0x02>;
				interrupt-names = "ima-rdy", "ima-xcp", "dma-xcp", "dma-grant", "mem-attn";
			};
		};

		pm8150b_vadc: vadc@3100 {
			compatible = "qcom,spmi-adc5";
			reg = <0x3100 0x100 0x3700 0x100>;
			reg-names = "adc5-usr-base", "adc5-cal-base";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <0x2 0x31 0x00 0x01>;
			interrupt-names = "eoc-int-en-set";
			qcom,adc-vdd-reference = <1875>;
			#io-channel-cells = <1>;
			io-channel-ranges;

			ref_gnd@0 {
				reg = <0x00>;
				label = "ref_gnd";
				qcom,pre-scaling = <1 1>;
			};

			vref_1p25@1 {
				reg = <0x01>;
				label = "vref_1p25";
				qcom,pre-scaling = <1 1>;
			};

			die_temp@2 {
				reg = <0x06>;
				label = "die_temp";
				qcom,pre-scaling = <1 1>;
			};

			chg_temp@9 {
				reg = <0x09>;
				label = "chg_temp";
				qcom,pre-scaling = <1 1>;
			};

			bat_id@4b {
				reg = <0x4b>;
				label = "bat_id";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			smb1390_therm@e {
				reg = <0x0e>;
				label = "smb1390_therm";
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			smb1355_therm@4e {
				reg = <0x4e>;
				label = "smb1355_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			vph_pwr@83 {
				reg = <0x83>;
				label = "vph_pwr";
				qcom,pre-scaling = <1 3>;
			};

			conn_therm@4f {
				reg = <0x4f>;
				label = "conn_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			chg_sbux@99 {
				reg = <0x99>;
				label = "chg_sbux";
				qcom,pre-scaling = <1 3>;
			};

			mid_chg_div6@1e {
				reg = <0x1e>;
				label = "chg_mid";
				qcom,pre-scaling = <1 6>;
			};

			usb_in_i_uv@7 {
				reg = <0x07>;
				label = "usb_in_i_uv";
				qcom,pre-scaling = <1 1>;
			};

			usb_in_v_div_16@8 {
				reg = <0x08>;
				label = "usb_in_v_div_16";
				qcom,pre-scaling = <1 16>;
			};
		};

		pm8150b_adc_tm: adc_tm@3500 {
			compatible = "qcom,adc-tm5";
			reg = <0x3500 0x100>;
			interrupts = <0x2 0x35 0x00 0x01>;
			interrupt-names = "thr-int-en";
			#address-cells = <1>;
			#size-cells = <0>;
			#thermal-sensor-cells = <1>;
			qcom,pmic-revid = <&pm8150b_revid>;
			io-channels = <&pm8150b_vadc 0x4f>;

			conn_therm@4f {
				reg = <0x4f>;
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
			};
		};
	};

	qcom,pm8150b@3 {
		compatible = "qcom,spmi-pmic";
		reg = <0x03 0x00>;
		#address-cells = <2>;
		#size-cells = <0>;

		pm8150b_pwm: qcom,pwms@b100 {
			compatible = "qcom,pwm-lpg";
			reg = <0xb100 0x200>;
			reg-names = "lpg-base";
			#pwm-cells = <2>;
			qcom,num-lpg-channels = <2>;
		};

		pm8150b_hr_led: qcom,leds@d000 {
			compatible = "qcom,tri-led";
			reg = <0xd000 0x100>;
			nvmem-names = "pbs_sdam";
			nvmem = <&pm8150_sdam_2>;

			hr_led1 {
				label = "hr_led1";
				pwms = <&pm8150b_pwm 0x0 0xf4240>;
				led-sources = <0>;
			};

			hr_led2 {
				label = "hr_led2";
				pwms = <&pm8150b_pwm 0x1 0xf4240>;
				led-sources = <1>;
			};
		};

		pm8150b_haptics: qcom,haptics@c000 {
			compatible = "qcom,haptics";
			reg = <0xc000 0x100>;
			interrupts = <0x03 0xc0 0x00 0x03 0x03 0xc0 0x01 0x03>;
			interrupt-names = "hap-sc-irq", "hap-play-irq";
			qcom,actuator-type = "lra";
			qcom,vmax-mv = <1697>;
			qcom,play-rate-us = <5882>;
			qcom,lra-resonance-sig-shape = "sine";
			qcom,lra-auto-resonance-mode = "qwd";
			qcom,lra-allow-variable-play-rate;
			vdd-supply = <&vreg_hap_boost>;

			wf_0 {
				qcom,effect-id = <0>;
				qcom,wf-vmax-mv = <0x6a1>;
				qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
				qcom,wf-play-rate-us = <5882>;
				qcom,wf-brake-pattern = <0x00>;
				qcom,wf-repeat-count = <0x01>;
				qcom,wf-s-repeat-count = <0x01>;
				qcom,lra-auto-resonance-disable;
			};

			wf_1 {
				qcom,effect-id = <1>;
				qcom,wf-vmax-mv = <0x6a1>;
				qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
				qcom,wf-play-rate-us = <5882>;
				qcom,wf-brake-pattern = <0x00>;
				qcom,wf-repeat-count = <0x01>;
				qcom,wf-s-repeat-count = <0x01>;
				qcom,lra-auto-resonance-disable;
			};

			wf_2 {
				qcom,effect-id = <2>;
				qcom,wf-vmax-mv = <0x6a1>;
				qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
				qcom,wf-play-rate-us = <5882>;
				qcom,wf-brake-pattern = <0x00>;
				qcom,wf-repeat-count = <0x01>;
				qcom,wf-s-repeat-count = <0x01>;
				qcom,lra-auto-resonance-disable;
			};

			wf_3 {
				qcom,effect-id = <3>;
				qcom,wf-vmax-mv = <0x6a1>;
				qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
				qcom,wf-play-rate-us = <5882>;
				qcom,wf-brake-pattern = <0x00>;
				qcom,wf-repeat-count = <0x01>;
				qcom,wf-s-repeat-count = <0x01>;
				qcom,lra-auto-resonance-disable;
			};

			wf_4 {
				qcom,effect-id = <4>;
				qcom,wf-vmax-mv = <0x6a1>;
				qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
				qcom,wf-play-rate-us = <5882>;
				qcom,wf-brake-pattern = <0x00>;
				qcom,wf-repeat-count = <0x01>;
				qcom,wf-s-repeat-count = <0x01>;
				qcom,lra-auto-resonance-disable;
			};

			wf_5 {
				qcom,effect-id = <5>;
				qcom,wf-vmax-mv = <0x6a1>;
				qcom,wf-pattern = <0x3e3e3e3e 0x3e3e3e3e>;
				qcom,wf-play-rate-us = <5882>;
				qcom,wf-brake-pattern = <0x00>;
				qcom,wf-repeat-count = <0x01>;
				qcom,wf-s-repeat-count = <0x01>;
				qcom,lra-auto-resonance-disable;
			};
		};
	};
};

&thermal_zones {

	pm8150b_temp_alarm: pm8150b_tz {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150b_tz>;
		wake-capable-sensor;

		trips {

			pm8150b_trip0: trip0 {
				temperature = <0x17318>;
				hysteresis = <0>;
				type = "passive";
			};

			pm8150b_trip1: trip1 {
				temperature = <0x1c138>;
				hysteresis = <0>;
				type = "passive";
			};

			trip2 {
				temperature = <0x23668>;
				hysteresis = <0>;
				type = "passive";
			};
		};
	};

	pm8150b-ibat-lvl0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150b_bcl 0x0>;
		wake-capable-sensor;

		trips {

			ibat_lvl0: ibat-lvl0 {
				temperature = <0x1194>;
				hysteresis = <200>;
				type = "passive";
			};
		};
	};

	pm8150b-ibat-lvl1 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150b_bcl 0x1>;
		wake-capable-sensor;

		trips {

			ibat_lvl1: ibat-lvl1 {
				temperature = <0x1f40>;
				hysteresis = <200>;
				type = "passive";
			};
		};
	};

	pm8150b-vbat-lvl0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "low_limits_cap";
		thermal-sensors = <&pm8150b_bcl 0x2>;
		tracks-low;
		wake-capable-sensor;

		trips {

			vbat_lvl0: vbat-lvl0 {
				temperature = <0xbb8>;
				hysteresis = <200>;
				type = "passive";
			};
		};
	};

	pm8150b-vbat-lvl1 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "low_limits_cap";
		thermal-sensors = <&pm8150b_bcl 0x3>;
		tracks-low;
		wake-capable-sensor;

		trips {

			vbat_lvl1: vbat-lvl1 {
				temperature = <0xaf0>;
				hysteresis = <200>;
				type = "passive";
			};
		};
	};

	pm8150b-vbat-lvl2 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "low_limits_cap";
		thermal-sensors = <&pm8150b_bcl 0x4>;
		tracks-low;
		wake-capable-sensor;

		trips {

			vbat_lvl2: vbat-lvl2 {
				temperature = <0xa28>;
				hysteresis = <200>;
				type = "passive";
			};
		};
	};

	pm8150b-bcl-lvl0 {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150b_bcl 0x5>;
		wake-capable-sensor;

		trips {

			b_bcl_lvl0: b-bcl-lvl0 {
				temperature = <0x01>;
				hysteresis = <1>;
				type = "passive";
			};
		};
	};

	pm8150b-bcl-lvl1 {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150b_bcl 0x6>;
		wake-capable-sensor;

		trips {

			b_bcl_lvl1: b-bcl-lvl1 {
				temperature = <0x01>;
				hysteresis = <1>;
				type = "passive";
			};
		};
	};

	pm8150b-bcl-lvl2 {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150b_bcl 0x7>;
		wake-capable-sensor;

		trips {

			b_bcl_lvl2: b-bcl-lvl2 {
				temperature = <0x01>;
				hysteresis = <1>;
				type = "passive";
			};
		};
	};

	soc {
		polling-delay-passive = <100>;
		polling-delay = <0>;
		thermal-governor = "low_limits_cap";
		thermal-sensors = <&bcl_soc>;
		tracks-low;
		wake-capable-sensor;

		trips {

			soc_trip: soc-trip {
				temperature = <0x0a>;
				hysteresis = <0>;
				type = "passive";
			};
		};
	};
};

&spmi_bus {
	#address-cells = <2>;
	#size-cells = <0>;
	interrupt-controller;
	#interrupt-cells = <4>;

	qcom,pm8150l@4 {
		compatible = "qcom,spmi-pmic";
		reg = <0x04 0x00>;
		#address-cells = <2>;
		#size-cells = <0>;

		pm8150l_revid: qcom,revid@100 {
			compatible = "qcom,qpnp-revid";
			reg = <0x100 0x100>;
		};

		qcom,power-on@800 {
			compatible = "qcom,qpnp-power-on";
			reg = <0x800 0x100>;
		};

		pm8150l_tz: qcom,temp-alarm@2400 {
			compatible = "qcom,spmi-temp-alarm";
			reg = <0x2400 0x100>;
			interrupts = <0x04 0x24 0x00 0x03>;
			io-channels = <&pm8150l_vadc 0x6>;
			io-channel-names = "thermal";
			#thermal-sensor-cells = <0>;
			qcom,temperature-threshold-set = <1>;
		};

		pm8150l_clkdiv: clock-controller@5b00 {
			compatible = "qcom,spmi-clkdiv";
			reg = <0x5b00 0x100>;
			#clock-cells = <1>;
			qcom,num-clkdivs = <1>;
			clock-output-names = "pm8150l_div_clk1";
			clocks = <&clock_rpmh>, <0x00>;
			clock-names = "xo";
		};

		pm8150l_gpios: pinctrl@c000 {
			compatible = "qcom,spmi-gpio";
			reg = <0xc000 0xc00>;
			interrupts = <0x4 0xc0 0x00 0x00 0x04 0xc2 0x00 0x00 0x04 0xc3 0x00 0x00 0x04 0xc4 0x00 0x00 0x04 0xc5 0x00 0x00 0x04 0xc6 0x00 0x00 0x04 0xc7 0x00 0x00 0x04 0xc9 0x00 0x00 0x04 0xca 0x00 0x00>;
			interrupt-names = "pm8150l_gpio1", "pm8150l_gpio3", "pm8150l_gpio4", "pm8150l_gpio5", "pm8150l_gpio6", "pm8150l_gpio7", "pm8150l_gpio8", "pm8150l_gpio10", "pm8150l_gpio11";
			gpio-controller;
			#gpio-cells = <2>;
			qcom,gpios-disallowed = <2 9 0x0c>;
		};

		pm8150l_vadc: vadc@3100 {
			compatible = "qcom,spmi-adc5";
			reg = <0x3100 0x100>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <0x4 0x31 0x00 0x01>;
			interrupt-names = "eoc-int-en-set";
			qcom,adc-vdd-reference = <1875>;
			#io-channel-cells = <1>;
			io-channel-ranges;

			ref_gnd@0 {
				reg = <0x00>;
				label = "ref_gnd";
				qcom,pre-scaling = <1 1>;
			};

			vref_1p25@1 {
				reg = <0x01>;
				label = "vref_1p25";
				qcom,pre-scaling = <1 1>;
			};

			die_temp@2 {
				reg = <0x06>;
				label = "die_temp";
				qcom,pre-scaling = <1 1>;
			};

			vph_pwr@83 {
				reg = <0x83>;
				label = "vph_pwr";
				qcom,pre-scaling = <1 3>;
			};

			camera_flash_therm@4d {
				reg = <0x4d>;
				label = "camera_flash_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			skin_msm_therm@4e {
				reg = <0x4e>;
				label = "skin_msm_therm";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};

			pa_therm2@4f {
				reg = <0x4f>;
				label = "pa_therm2";
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
				qcom,pre-scaling = <1 1>;
			};
		};

		pm8150l_bcl: bcl@3d00 {
			compatible = "qcom,bcl-v5";
			reg = <0x3d00 0x100>;
			interrupts = <0x4 0x3d 0x00 0x00 0x04 0x3d 0x01 0x00 0x04 0x3d 0x02 0x00>;
			interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
			#thermal-sensor-cells = <1>;
		};

		pm8150l_adc_tm: adc_tm@3500 {
			compatible = "qcom,adc-tm5";
			reg = <0x3500 0x100>;
			interrupts = <0x4 0x35 0x00 0x01>;
			interrupt-names = "thr-int-en";
			#address-cells = <1>;
			#size-cells = <0>;
			#thermal-sensor-cells = <1>;
			io-channels = <&pm8150l_vadc 0x4d>, <&pm8150l_vadc 0x4e>, <&pm8150l_vadc 0x4f>;

			camera_flash_therm@4d {
				reg = <0x4d>;
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
			};

			skin_msm_therm@4e {
				reg = <0x4e>;
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
			};

			pa_therm2@4f {
				reg = <0x4f>;
				qcom,ratiometric;
				qcom,hw-settle-time = <200>;
			};
		};
	};

	qcom,pm8150l@5 {
		compatible = "qcom,spmi-pmic";
		reg = <0x05 0x00>;
		#address-cells = <2>;
		#size-cells = <0>;

		pm8150l_lcdb: qcom,lcdb@ec00 {
			compatible = "qcom,qpnp-lcdb-regulator";
			reg = <0xec00 0x100>;
			interrupts = <0x05 0xec 0x01 0x01>;
			interrupt-names = "sc-irq";
			qcom,pmic-revid = <&pm8150l_revid>;
			qcom,voltage-step-ramp;
			status = "ok";

			lcdb_ldo_vreg: ldo {
				label = "ldo";
				regulator-name = "lcdb_ldo";
				regulator-min-microvolt = "", "=\t";
				regulator-max-microvolt = <6000000>;
			};

			lcdb_ncp_vreg: ncp {
				label = "ncp";
				regulator-name = "lcdb_ncp";
				regulator-min-microvolt = "", "=\t";
				regulator-max-microvolt = <6000000>;
			};

			lcdb_bst_vreg: bst {
				label = "bst";
				regulator-name = "lcdb_bst";
				regulator-min-microvolt = <4700000>;
				regulator-max-microvolt = <6275000>;
			};
		};

		flash_led: qcom,leds@d300 {
			compatible = "qcom,qpnp-flash-led-v2";
			status = "okay";
			reg = <0xd300 0x100>;
			label = "flash";
			interrupts = <0x05 0xd3 0x00 0x01 0x05 0xd3 0x03 0x01 0x05 0xd3 0x04 0x01>;
			interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";
			qcom,hdrm-auto-mode;
			qcom,short-circuit-det;
			qcom,open-circuit-det;
			qcom,vph-droop-det;
			qcom,thermal-derate-en;
			qcom,thermal-derate-current = <200 500 0x3e8>;
			qcom,isc-delay = <192>;
			qcom,pmic-revid = <&pm8150l_revid>;

			pm8150l_flash0: qcom,flash_0 {
				label = "flash";
				qcom,led-name = "led:flash_0";
				qcom,max-current = <1500>;
				qcom,default-led-trigger = "flash0_trigger";
				qcom,id = <0>;
				qcom,current-ma = <1000>;
