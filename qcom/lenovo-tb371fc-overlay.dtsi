		};
	};

	xo-therm-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150_adc_tm 0x4c>;

		trips {

			xo_lvl0: active-config0 {
				temperature = <0xa410>;
				hysteresis = <2000>;
				type = "passive";
			};

			xo_lvl1: active-config1 {
				temperature = <0xb3b0>;
				hysteresis = <2000>;
				type = "passive";
			};

			xo_lvl2: active-config2 {
				temperature = <0xdac0>;
				hysteresis = <6000>;
				type = "passive";
			};
		};

		cooling-maps {

