		pinctrl-1 = <&cam_sensor_mclk0_suspend>, <&cam_sensor_suspend_rear>;
		gpios = <&tlmm>, <&rx_swr_clk_active>, <0x00>, <&tlmm>, <&wsa_swr_data_sleep>, <0x00>;
