&qupv3_se1_i2c {
	status = "ok";
	#qcom,clk-freq-out = <0xf4240>;
	#address-cells = <1>;
	#size-cells = <0>;

	ctn730@28 {
		compatible = "nxp,ctn730";
		reg = <0x28>;
		rst-gpios = <&tlmm 0x54 0x0>;
		enable-gpios = <&tlmm 0xa0 0x0>;
		interrupt-gpios = <&tlmm 0x6f 0x0>;
		interrupt-parent = <&tlmm>;
		interrupts = <0x6f 0x00>;
		interrupt-names = "nfc_irq";
	};
};

&qupv3_se9_i2c {
	status = "okay";

	OCH8801_0: dhall@18 {
		status = "okay";
		compatible = "isentek,OCH8801-0";
		reg = <0x18>;
		data-range = <0x0>;
		hall,bias_support = <0x0>;
		hall,bias-ratio = <0x5a>;
		hall,irq-gpio = <&tlmm 0x9e 0x0>;
	};
};

&qupv3_se13_i2c {
	clock-frequency = <1000000>;
	status = "okay";

	mouse@60 {
		compatible = "hid-over-i2c";
		reg = <0x60>;
		mcu_rst_gpio = <&tlmm 0x72 0x00>;
		mcu_resume_gpio = <&tlmm 0x6c 0x00>;
		interrupt-parent = <&tlmm>;
		interrupts = <0x6e 0x00>;
		interrupt-names = "keyboard_irq";
		hid-descr-addr = <0x1>;
		post-power-on-delay-ms = <100>;
	};
};

