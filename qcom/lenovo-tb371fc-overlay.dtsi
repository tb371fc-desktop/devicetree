		pwm-switch;
		rgltr-min-voltage = <1800000 2800000 0x124f80 0x00>;
		rgltr-max-voltage = <1800000 2800000 0x124f80 0x00>;
		rgltr-load-current = <120000 80000 1200000 0>;
		gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
