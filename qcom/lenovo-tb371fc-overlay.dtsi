&tlmm {

	cam_sensor_active_rst2: cam_sensor_active_rst2 {
		mux {
			pins = "gpio92";
			function = "gpio";
		};

		config {
			pins = "gpio92";
			bias-disable;
			drive-strength = <PMIC_GPIO_PULL_UP_31P5>;
		};
	};

	cam_sensor_suspend_rst2: cam_sensor_suspend_rst2 {
		mux {
			pins = "gpio92";
			function = "gpio";
		};

		config {
			pins = "gpio92";
			bias-pull-down;
			drive-strength = <PMIC_GPIO_PULL_UP_31P5>;
			output-low;
		};
	};
};

