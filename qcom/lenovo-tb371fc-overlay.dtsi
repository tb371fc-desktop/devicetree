			};

			pa1_skin_lvl1 {
				trip = <&pa1_lvl1>;
				cooling-device = <&modem_mmw_skin0>, <&pm8150_tz>, <&pm8150_tz>;
			};

			pa1_skin_lvl2 {
				trip = <&pa1_lvl2>;
				cooling-device = <&modem_mmw_skin0>, <&pm8150b_vadc>, <0x3>;
			};
		};
	};

	mmw-pa2-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150l_adc_tm 0x4f>;

		trips {

			pa2_lvl0: active-config0 {
				temperature = <0xa410>;
				hysteresis = <4000>;
				type = "passive";
			};

			pa2_lvl1: active-config1 {
				temperature = <0xb3b0>;
				hysteresis = <2000>;
				type = "passive";
			};

			pa2_lvl2: active-config2 {
				temperature = <0xdac0>;
				hysteresis = <6000>;
				type = "passive";
			};
		};

		cooling-maps {

			pa2_skin_lvl0 {
				trip = <&pa2_lvl0>;
				cooling-device = <&modem_mmw_skin1>, <&pm8150_vadc>, <0x1>;
			};

			pa2_skin_lvl1 {
				trip = <&pa2_lvl1>;
				cooling-device = <&modem_mmw_skin1>, <&pm8150_tz>, <&pm8150_tz>;
			};

			pa2_skin_lvl2 {
				trip = <&pa2_lvl2>;
				cooling-device = <&modem_mmw_skin1>, <&pm8150b_vadc>, <0x3>;
			};
		};
	};

	skin-therm-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150_adc_tm 0x4d>;
		wake-capable-sensor;
		disable-thermal-zone;

		trips {

			skin_therm0: active-config0 {
				temperature = <0xf230>;
				hysteresis = <5000>;
				type = "passive";
			};

			skin_therm1: active-config1 {
				temperature = <0xfde8>;
				hysteresis = <5000>;
				type = "passive";
			};

			skin_therm2: active-config2 {
				temperature = <0x11940>;
				hysteresis = <2000>;
				type = "passive";
			};
		};

		cooling-maps {

			skin_lvl0 {
				trip = <&skin_therm0>;
				cooling-device = <&modem_skin>, <&pm8150_vadc>, <0x1>;
			};

			skin_lvl1 {
				trip = <&skin_therm1>;
				cooling-device = <&modem_skin>, <&pm8150_tz>, <&pm8150_tz>;
			};

			skin_lvl2 {
				trip = <&skin_therm2>;
				cooling-device = <&modem_skin>, <&pm8150b_vadc>, <0x3>;
			};
		};
	};
};

&sdhc_2 {
	vdd-supply = <&pm8150a_l9>;
	qcom,vdd-voltage-level = <2950000 2960000>;
	qcom,vdd-current-level = <200 800000>;
	qcom,vdd-always-on;
	vdd-io-supply = <&pm8150a_l6>;
	qcom,vdd-io-voltage-level = <1808000 2960000>;
	qcom,vdd-io-current-level = <200 22000>;
	pinctrl-names = "active", "sleep";
	pinctrl-0 = <&sdc2_clk_on>, <&sdc2_cmd_on>, <&sdc2_data_on>, <&storage_cd>;
	pinctrl-1 = <&sdc2_clk_off>, <&sdc2_cmd_off>, <&sdc2_data_off>, <&storage_cd>;
	cd-gpios = <&tlmm>, <&vreg_hap_boost>, <0x00>;
	pwr-gpios = <&tlmm 0x4b 0x00>;
	status = "ok";
};

&vendor {

	bluetooth: bt_qca6390 {
		compatible = "qca,qca6390";
		pinctrl-names = "default";
		pinctrl-0 = <&bt_en_sleep>;
		qca,bt-reset-gpio = <&tlmm>, <&pm8150l_tz>, <0x00>;
		qca,bt-sw-ctrl-gpio = <&tlmm 0x7c 0x00>;
		qca,bt-vdd-aon-supply = <&pm8150_s6>;
		qca,bt-vdd-dig-supply = <&pm8150_s6>;
		qca,bt-vdd-rfa1-supply = <&pm8150_s5>;
		qca,bt-vdd-rfa2-supply = <&pm8150a_s8>;
		qca,bt-vdd-asd-supply = <&pm8150_l16>;
		qca,bt-vdd-aon-voltage-level = <950000 950000>;
		qca,bt-vdd-dig-voltage-level = <950000 952000>;
		qca,bt-vdd-rfa1-voltage-level = <1900000 1900000>;
		qca,bt-vdd-rfa2-voltage-level = <1350000 1350000>;
		qca,bt-vdd-asd-voltage-level = <3024000 3304000>;
		qca,bt-vdd-asd-current-level = <10000>;
	};
};

&usb0 {
	dwc3@a600000 {
		maximum-speed = "super-speed-plus";
	};
};

&usb1 {
	qcom,default-mode-none;
};

&wil6210 {
	status = "ok";
};

&usb2_phy0 {
	qcom,param-override-seq = <0xc7 0x6c 0x0f 0x70 0x03 0x74>;
};

&qupv3_se5_i2c {
	status = "ok";

	ktz8866@11 {
		compatible = "ktz,ktz8866a";
		status = "ok";
		reg = <0x11>;
		ktz8866,hwen-gpio = <&tlmm 0x36 0x0>;
		ktz8866,enp-gpio = <&tlmm 0x4d 0x0>;
		ktz8866,enn-gpio = <&tlmm 0x4e 0x0>;
	};
};

&qupv3_se11_i2c {
	status = "ok";

	ktz8866@11 {
		compatible = "ktz,ktz8866b";
		status = "ok";
		reg = <0x11>;
		ktz8866,hwen-gpio = <&tlmm 0x36 0x0>;
		ktz8866,enp-gpio = <&tlmm 0x4d 0x0>;
		ktz8866,enn-gpio = <&tlmm 0x4e 0x0>;
	};
};

&qupv3_se13_i2c {
	status = "ok";
	qcom,i2c-touch-active = <0x0>;

	st_fts@49 {
		st,x-flip;
		st,y-flip;
	};
};

&kona_snd {
	qcom,msm-mbhc-usbc-audio-supported = <0x00>;
	qcom,msm-mbhc-hphl-swh = <1>;
	qcom,msm-mbhc-gnd-swh = <1>;
};

&usb1 {
	qcom,ignore-wakeup-src-in-hostmode;

	dwc3@a800000 {
		dr_mode = "host";
	};
};

&usb2_phy0 {
	qcom,param-override-seq = <0xc7 0x6c 0x03 0x70 0x03 0x74>;
};

&mdm0 {
	status = "disabled";
};

&qupv3_se1_i2c {
	status = "ok";
	qcom,clk-freq-out = <100000>;
	#address-cells = <1>;
	#size-cells = <0>;

	lt9611: lt,lt9611@2b {
		compatible = "lt,lt9611uxc";
		reg = <0x2b>;
		interrupt-parent = <&tlmm>;
		interrupts = <0x01 0x00>;
		interrupt-names = "lt_irq";
		lt,irq-gpio = <&tlmm>, <&pm8150_vadc>, <0x0>;
		lt,reset-gpio = <&tlmm>, <&pm8150_tz>, <0x00>;
		instance_id = <0>;
		lt,non-pluggable;
		pinctrl-names = "default";
		pinctrl-0 = <&lt9611_pins>;
		lt,preferred-mode = "1920x1080";

		lt,customize-modes {

			lt,customize-mode-id@0 {
				lt,mode-h-active = <1920>;
				lt,mode-h-front-porch = <88>;
				lt,mode-h-pulse-width = <44>;
				lt,mode-h-back-porch = <148>;
				lt,mode-h-active-high;
				lt,mode-v-active = <1080>;
				lt,mode-v-front-porch = <4>;
				lt,mode-v-pulse-width = <5>;
				lt,mode-v-back-porch = <36>;
				lt,mode-v-active-high;
				lt,mode-refresh-rate = <60>;
				lt,mode-clock-in-khz = <148500>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0x00>;

				lt9611_in: endpoint {
					remote-endpoint = <&ext_dsi_out>;
				};
			};
		};
	};
};

&pcie2 {
	qcom,boot-option = <0x00>;
};

&mhi_0 {
	reg = <0x100 0x00 0x00 0x00 0x00>;
};

&pcie2_rp {
	#address-cells = <5>;
	#size-cells = <0>;

	nvme: nvme {
		reg = <0x00 0x00 0x00 0x00 0x00>;
		qcom,iommu-group = <&nvme_pci_iommu_group>;
		#address-cells = <1>;
		#size-cells = <1>;

		nvme_pci_iommu_group: nvme_pci_iommu_group {
			qcom,iommu-dma-addr-pool = <0x20000000 0x40000000>;
			qcom,iommu-dma = "fastmap";
		};
	};
};


