				type = "passive";
			};
		};
	};

	skin-msm-therm-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150l_adc_tm 0x4e>;
		wake-capable-sensor;

		trips {

			active-config0 {
				temperature = <0x1e848>;
				hysteresis = <1000>;
				type = "passive";
			};

			active-config1 {
				temperature = <0x1e848>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	mmw-pa2-usr {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150l_adc_tm 0x4f>;
		wake-capable-sensor;

		trips {

			active-config0 {
				temperature = <0x1e848>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	chg-skin-therm-usr {
		polling-delay-passive = <1000>;
		polling-delay = <5000>;
		thermal-governor = "user_space";
		thermal-sensors = <&pm8150l_adc_tm 0x4f>;
		wake-capable-sensor;

		trips {

			virt_trip0: virt-trip0 {
				temperature = <0x8ca0>;
				hysteresis = <2000>;
				type = "passive";
			};

			virt_trip1: virt-trip1 {
				temperature = <0x9470>;
				hysteresis = <2000>;
				type = "passive";
			};

			virt_trip2: virt-trip2 {
				temperature = <0x9c40>;
				hysteresis = <2000>;
				type = "passive";
			};

			virt_trip3: virt-trip3 {
				temperature = <0xa410>;
				hysteresis = <2000>;
				type = "passive";
			};

			virt_trip4: virt-trip4 {
				temperature = <0xabe0>;
				hysteresis = <2000>;
				type = "passive";
			};

			virt_trip5: virt-trip5 {
				temperature = <0xb3b0>;
				hysteresis = <2000>;
				type = "passive";
			};

			virt_trip6: virt-trip6 {
				temperature = <0xc350>;
				hysteresis = <4000>;
				type = "passive";
			};
		};

		cooling-maps {

			batt_cdev0 {
				trip = <&virt_trip0>;
				cooling-device = <&pm8150b_charger 0x0 0xf>;
			};

			batt_cdev1 {
				trip = <&virt_trip1>;
				cooling-device = <&pm8150b_charger 0x0 0xf>;
			};

			batt_cdev2 {
				trip = <&virt_trip2>;
				cooling-device = <&pm8150b_charger 0x0 0xf>;
			};

			batt_cdev3 {
				trip = <&virt_trip3>;
				cooling-device = <&pm8150b_charger 0x0 0xf>;
			};

			batt_cdev4 {
				trip = <&virt_trip4>;
				cooling-device = <&pm8150b_charger 0x0 0xf>;
			};

			batt_cdev5 {
				trip = <&virt_trip5>;
				cooling-device = <&pm8150b_charger 0x0 0xf>;
			};

			batt_cdev6 {
				trip = <&virt_trip6>;
				cooling-device = <&pm8150b_charger 0x0 0xf>;
			};
		};
	};

	gpu-skin-avg-step {
		polling-delay-passive = <1000>;
		polling-delay = <5000>;
		thermal-governor = "step_wise";

		trips {

			virt_trip: virt-trip {
				temperature = <0x14c08>;
				hysteresis = <2000>;
				type = "passive";
			};
		};

		cooling-maps {

			gpu_cdev {
				trip = <&virt_trip>;
				cooling-device = <&msm_gpu>, <0x00>, <&pm8150_vadc>;
			};
		};
	};

	skin-msm-therm-step {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-governor = "step_wise";
		thermal-sensors = <&pm8150l_adc_tm 0x4e>;
		wake-capable-sensor;

		trips {

			skin_trip: skin-config0 {
				temperature = <0xb3b0>;
				hysteresis = <0>;
				type = "passive";
			};
		};

		cooling-maps {

			lcd_cdev {
				trip = <&skin_trip>;
				cooling-device = <&mdss_mdp>, <&usb2_vbus_boost_default>, <&usb2_vbus_boost_default>;
