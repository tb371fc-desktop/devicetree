&ufsphy_mem {
	compatible = "qcom,ufs-phy-qmp-v4";
	vdda-phy-supply = <&pm8150_l5>;
	vdda-phy-always-on;
	vdda-pll-supply = <&pm8150_l9>;
	vdda-phy-max-microamp = <89900>;
	vdda-pll-max-microamp = <18800>;
	status = "ok";
};

&ufshc_mem {
	vdd-hba-supply = <&ufs_phy_gdsc>;
	vdd-hba-fixed-regulator;
	vcc-supply = <&pm8150_l17>;
	vcc-voltage-level = <0x263540 0x2d0370>;
	vcc-low-voltage-sup;
	vccq-supply = <&pm8150_l6>;
	vccq2-supply = <&pm8150_s4>;
	vcc-max-microamp = "", "\f5";
	vccq-max-microamp = "", "\f5";
	vccq2-max-microamp = "", "\f5";
	qcom,vddp-ref-clk-supply = <&pm8150_l6>;
	qcom,vddp-ref-clk-max-microamp = <0x64>;
	qcom,vccq-parent-supply = <&pm8150a_s8>;
	qcom,vccq-parent-max-microamp = <0x33450>;
	status = "ok";
};

&soc {

	gpio_keys {
		compatible = "gpio-keys";
		label = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_vol_up_default>;

		vol_up {
			label = "volume_up";
			gpios = <&pm8150_gpios 0x6 0x1>;
			linux,input-type = <1>;
			linux,code = <115>;
			gpio-key,wakeup;
			debounce-interval = <15>;
			linux,can-disable;
		};
	};

	goodix_fp {
		status = "okay";
		compatible = "goodix,fingerprint";
		interrupt-parent = <&tlmm>;
		interrupts = <0x17 0x00>;
		fp-gpio-irq = <&tlmm 0x17 0x0>;
		fp-gpio-reset = <&tlmm 0x55 0x0>;
		goodix_vdd-supply = <&pm8150a_l11>;
	};

	qcom,qbt_handler {
		status = "disabled";
		compatible = "qcom,qbt-handler";
		qcom,ipc-gpio = <&tlmm>, <&pm8009_gpios>, <0x0>;
		pinctrl-names = "default";
		pinctrl-0 = <&key_home_default>;
		qcom,finger-detect-gpio = <&pm8150_gpios 0x1 0x0>;
	};
};

&qupv3_se3_i2c {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "ok";

	mm8013_battery: mitsumi,mm8013@55 {
		compatible = "mitsumi,mm8013c06";
		reg = <0x55>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "ok";
	};
};

&qupv3_se15_i2c {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "ok";

	redriver: redriver@1c {
		compatible = "onnn,redriver";
		reg = <0x1c>;
		extcon = <&pm8150b_pdphy>, <&pm8150b_pdphy>;
		eq = <67372036 100926470>;
		flat-gain = <50397443 33620226>;
		output-comp = <50529027 50529027>;
		loss-match = <16974593 50529027>;
		status = "disabled";
	};

	smb1390: qcom,smb1390@10 {
		compatible = "qcom,i2c-pmic";
		reg = <0x10>;
		#address-cells = <1>;
		#size-cells = <0>;
		interrupt-parent = <&spmi_bus>;
		interrupts = <0x2 0xc5 0x0 0x08>;
		interrupt_names = "smb1390";
