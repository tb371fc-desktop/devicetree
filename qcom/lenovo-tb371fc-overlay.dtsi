&qupv3_se14_spi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "ok";
	pinctrl-0 = <&qupv3_se14_spi_active>;
	pinctrl-1 = <&qupv3_se14_spi_sleep>;

	novatek@0 {
		compatible = "novatek,NVT-ts-spi";
		panel = <&dsi_panel_spinel_boe_nt36532_dsc_3k_video>, <&dsi_panel_spinel_tianma_nt36532_dsc_3k_video>;
		reg = <0x00>;
		status = "ok";
		spi-max-frequency = <9600000>;
		novatek,reset-gpio = <&tlmm 56 IRQ_TYPE_NONE>;
		/*
		 * What is 0x2001?
		 * In the driver context it is used as following:
		 * ```
		 * 	ts->irq_gpio = of_get_named_gpio_flags(np, "novatek,irq-gpio", 0, &ts->irq_flags);
		 * ```
		 * but `irq_flags` usage is not seen anywhere
		 */
		novatek,irq-gpio = <&tlmm 68 0x2001>;
		novatek,pen-support;
		novatek,stylus-resol-double;
		novatek,mp-support-dt;

		novatek-mp-criteria-6067@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "novatek-mp-criteria-6067";
			IC_X_CFG_SIZE = <60>;
			IC_Y_CFG_SIZE = <40>;
			IC_KEY_CFG_SIZE = <4>;
