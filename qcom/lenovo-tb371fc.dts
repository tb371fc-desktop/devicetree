&mdss_mdp {
	clock-rate = <0 0 0 0 460000000 19200000 300000000 19200000>;
};

&mdss_dsi_phy0 {
	qcom,platform-lane-config = [00 00 0a 0a
				     00 00 0a 0a
				     00 00 0a 0a
				     00 00 0a 0a
				     20 00 8a 8a];
};

&mdss_dsi_phy1 {
	qcom,platform-lane-config = [00 00 0a 0a
				     00 00 0a 0a
				     00 00 0a 0a
				     00 00 0a 0a
				     20 00 8a 8a];
};

&cam_cci0 {
	pinctrl-0 = <&cci0_active>;
	pinctrl-1 = <&cci0_suspend>;
	gpios = <&tlmm 101 GPIO_ACTIVE_HIGH>,
		<&tlmm 102 GPIO_ACTIVE_HIGH>;
	gpio-req-tbl-num = <0 1>;
	gpio-req-tbl-flags = <1 1>;
	gpio-req-tbl-label = "CCI_I2C_DATA0", "CCI_I2C_CLK0";
};

&cam_cci1 {
	pinctrl-0 = <&cci2_active>;
	pinctrl-1 = <&cci2_suspend>;
	gpios = <&tlmm 105 GPIO_ACTIVE_HIGH>,
		<&tlmm 106 GPIO_ACTIVE_HIGH>;
	gpio-req-tbl-num = <0 1>;
	gpio-req-tbl-flags = <1 1>;
	gpio-req-tbl-label = "CCI_I2C_DATA2", "CCI_I2C_CLK2";
};

&qupv3_se15_i2c {
	status = "ok";

	/delete-node/ fsa4480@43;

	tfa98xx@34 {
		compatible = "tfa,tfa98xx";
		reg = <0x34>;
		reset-gpio = <&tlmm 0x73 GPIO_ACTIVE_HIGH>;
	};

	tfa98xx@35 {
		compatible = "tfa,tfa98xx";
		reg = <0x35>;
		reset-gpio = <&tlmm 0x75 GPIO_ACTIVE_HIGH>;
	};

	tfa98xx@36 {
		compatible = "tfa,tfa98xx";
		reg = <0x36>;
		reset-gpio = <&tlmm 0x76 GPIO_ACTIVE_HIGH>;
	};

	tfa98xx@37 {
		compatible = "tfa,tfa98xx";
		reg = <0x37>;
		reset-gpio = <&tlmm 0x74 GPIO_ACTIVE_HIGH>;
	};
};

&qupv3_se19_i2c {
	status = "ok";

	fsa4480: fsa4480@42 {
		compatible = "qcom,fsa4480-i2c";
		reg = <0x42>;
	};
};

&qupv3_se14_spi {
	status = "ok";
};

&tdm_pri_rx {
	qcom,msm-cpudai-tdm-clk-rate = <6144000>;
	qcom,msm-cpudai-tdm-sync-mode = <0>;
};

&tdm_pri_tx {
	qcom,msm-cpudai-tdm-clk-rate = <6144000>;
	qcom,msm-cpudai-tdm-sync-mode = <0>;
};

&reserved_memory {
	bootlog_mem: boot_log_region@0 {
		compatible = "removed-dma-pool";
		no-map;
		reg = <0x0 0xb0000000 0x0 0x80000>;
	};
};
