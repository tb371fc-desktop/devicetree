/dts-v1/;

#include "kona-v2.1.dtsi"

/ {
	model = "Lenovo Xiaoxin Pad Pro 12.7 TB371FC";
	compatible = "qcom,kona";
	qcom,board-id = <0 0>;
};

&soc {
	sim: simtray {
		compatible = "Lenovo,simtray-status";
		cd-gpios = <&tlmm 14 GPIO_ACTIVE_HIGH>;
	};

	sn_fuse: snfuse@0x00786134 {
		compatible = "qcom,sn-fuse";
		reg = <0x786134 0x4>;
		reg-names = "sn-base";
	};

	qcom,rmnet-ipa {
		status = "disabled";
	};
};

&slim_aud {
	hwinfo: HardwareInfo {
		compatible = "huaqin,hardware_info";
		status = "okay";
	};
};

&mdm0 {
	status = "disabled";
};

&apps_rsc {
	rpmh-regulator-ldoc8 {
		status = "ok";
	};

	rpmh-regulator-ldoc10 {
		status = "ok";
	};
};

&pm8150a_l1 {
	regulator-always-on;
	status = "ok";
};

&pm8150a_l8 {
	regulator-always-on;
	status = "ok";
};

&pm8150a_l10 {
	qcom,init-mode = <RPMH_REGULATOR_MODE_HPM>;
	qcom,init-voltage = <3312000>;
	regulator-always-on;
	regulator-max-microvolt = <3312000>;
	regulator-min-microvolt = <3312000>;
	status = "ok";
};

&ipa_hw {
	status = "disabled";
};

&wlan {
	vdd-wlan-dig-supply = <&pm8150_s6>;
};

&pcie1 {
	wake-gpio = <&tlmm 81 GPIO_ACTIVE_HIGH>;
};

&pcie1_wake_default {
	config {
		/delete-property/ bias-pull-up;
		pins = "gpio81";
		bias-disable;
	};

	mux {
		pins = "gpio81";
	};
};

&pcie2 {
	status = "disabled";
};

&tlmm {
    /*
     * Note:
     *
     * The original tb371fc base DTB does not contain `pmx_sde` node.
     *
     * To keep the inherited `kona-pinctrl.dtsi` untouched,
     * the DTS could use `/delete-node/ pmx_sde;`,
     * but this directive does not apply at runtime during DTBO merging.
     *
     * The overlay may inherit `kona-sde-display.dtsi`,
     * containing the following default assignments:
     *
     *   pinctrl-0 = <&sde_dsi_active &sde_te_active>;
     *   pinctrl-1 = <&sde_dsi_suspend &sde_te_suspend>;
     *
     * ...where `sde_dsi_active` and `sde_dsi_suspend` are defined in `pmx_sde`.
     *
     * Later files or fragments may override these assignments, e.g.:
     *
     *   pinctrl-0 = <&sde_te_active &sde_bl_active>;
     *   pinctrl-1 = <&sde_te_suspend &sde_bl_suspend>;
     *
     * ...which no longer use `sde_dsi_active` and `sde_dsi_suspend`.
     *
     * However, because DTC evaluates all referenced labels when generating
     * the overlay binary, the unused `sde_dsi_*` labels are still compiled
     * into the `__fixups__` table.
     *
     * As a result, the compiled DTBO contains dangling phandle references
     * to labels missing from the base DTB, causing the bootloader's overlay
     * engine to fail during boot.
     *
     * So, instead of deleting the node here,
     * the whole node is commented out from `kona-pinctrl.dtsi`
     */

	// /delete-node/ pmx_sde;

	pmx_sde_bl {
		sde_bl_active: sde_bl_active {
			config {
				pins = "gpio33", "gpio54", "gpio77", "gpio78";
				drive-strength = <2>;   /* 2 mA */
				bias-pull-down;
				output-high;
			};

			mux {
				function = "gpio";
				pins = "gpio33", "gpio54", "gpio77", "gpio78";
			};
		};

		sde_bl_suspend: sde_bl_suspend {
			config {
				pins = "gpio33", "gpio54", "gpio77", "gpio78";
				drive-strength = <2>;   /* 2 mA */
				bias-pull-down;
				output-low;
			};

			mux {
				pins = "gpio33", "gpio54", "gpio77", "gpio78";
				function = "gpio";
			};
		};
	};

	nfc {
		ctn730_int_default: ctn730_int_default {
			config {
				pins = "gpio84";
				drive-strength = <2>;   /* 2 mA */
				bias-disable;
				input-enable;
			};

			mux {
				pins = "gpio84";
				function = "gpio";
			};
		};
	};
};

&storage_cd {
	config {
		pins = "gpio14";
	};

	mux {
		pins = "gpio14";
	};
};

&cam_sensor_active_rst2 {
	config {
		pins = "gpio93";
	};

	mux {
		pins = "gpio93";
	};
};
&cam_sensor_suspend_rst2 {
	config {
		pins = "gpio93";
	};

	mux {
		pins = "gpio93";
	};
};

&cam_sensor_active_rgbleft {
	config {
		pins = "gpio93";
	};

	mux {
		pins = "gpio93";
	};
};

&cam_sensor_suspend_rgbleft {
	config {
		pins = "gpio93";
	};

	mux {
		pins = "gpio93";
	};
};

&nfc_enable_active {
	mux {
		pins = "gpio25";
	};

	config {
		pins = "gpio25";
	};
};

&nfc_enable_suspend {
	mux {
		pins = "gpio25";
	};

	config {
		pins = "gpio25";
	};
};

&nfc_clk_req_active {
	mux {
		pins = "gpio84";
	};

	config {
		pins = "gpio84";
	};
};

&nfc_clk_req_suspend {
	mux {
		pins = "gpio84";
	};

	config {
		pins = "gpio84";
	};
};


